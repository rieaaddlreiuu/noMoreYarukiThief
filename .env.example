# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Optional: register commands instantly in a development server; omit for global commands.
DISCORD_GUILD_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server-side token for higher GitHub API rate limits. No user OAuth tokens are stored.
# Use a token without private-repository access. Public repository reads need no extra scopes.
GITHUB_API_TOKEN=

# Optional: enables AI judgement of commit contents (messages and diffs) against the declaration.
# Set the API key of one provider. Unset falls back to accepting the first matching commit, exactly
# as before. Reading diffs adds up to 10 GitHub requests per check, so GITHUB_API_TOKEN is recommended.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: gemini | openai | anthropic. Needed only when several keys are set; otherwise the
# provider is detected from its key, trying Gemini, then OpenAI, then Anthropic.
AI_PROVIDER=
# Optional: overrides the provider's default model (gemini-2.5-flash / gpt-6-luna / claude-opus-5-5).
AI_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
