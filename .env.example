# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server-side fallback token for higher GitHub API rate limits.
# Use a token without private-repository access. Public repository reads need no extra scopes.
GITHUB_API_TOKEN=
# Optional: 32 random bytes, base64. When set, each linked user's OAuth token (empty scope, public data only)
# is stored AES-256-GCM encrypted and used for that user's commit checks. Unset: tokens are not stored.
# Losing or rotating this key only forces users to relink. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Optional: enables AI judgement of commit messages against the declaration. Unset falls back
# to accepting the first matching commit, exactly as before.
GEMINI_API_KEY=
# Optional: Gemini model name. Defaults to gemini-3.8-flash; set it when Google retires the model.
GEMINI_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
